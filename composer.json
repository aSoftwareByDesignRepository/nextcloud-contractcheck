{
    "name": "contractcheck/nextcloud-contractcheck",
    "description": "Contract register with deadline engine (Kuendigungsfristen), reminders, documents and cost rollups for Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Alexander Mäule"
        },
        {
            "name": "Software by Design GbR"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "doctrine/dbal": "^3.9",
        "nextcloud/ocp": "^32.0 || ^33.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\ContractCheck\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\ContractCheck\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/",
            "NCU\\": "vendor/nextcloud/ocp/NCU/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mutation:deadline": "php tests/Mutation/run-deadline-mutations.php",
        "test:mutation:critical": "php tests/Mutation/run-critical-mutations.php",
        "phpstan": "phpstan analyse -c phpstan.neon.dist -a phpstan-bootstrap.php lib/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}